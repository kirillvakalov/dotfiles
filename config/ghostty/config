theme = Thorn Forest
# font-family = MonoLisa
# font-style-italic = Regular Italic
# font-size = 12
# font-feature = -calt
# font-feature = -liga
font-family = Cozette
font-style-italic = Medium
font-style-bold = Medium
font-style-bold-italic = Medium
font-size = 13
confirm-close-surface = false
quit-after-last-window-closed = true
macos-option-as-alt = true
keybind = cmd+enter=unbind
keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up
keybind = cmd+l=goto_split:right
