{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
  "providers": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4.1-flash-1017": {
          "body": {
            "provider": {
              "only": ["baseten", "together", "deepseek"],
              "sort": "throughput"
            }
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "disabled": false,
        "command": ["npx", "-y", "chrome-devtools-mcp@1.11.0"]
      },
      "jadx": {
        "type": "local",
        "command": [
          "uv",
          "run",
          "--directory",
          "/Users/kirillvakalov/.local/share/jadx-mcp-server",
          "jadx_mcp_server.py"
        ]
      },
      "rea": {
        "type": "local",
        "command": ["npx", "-y", "rea-agents@6.7.0", "mcp"]
      }
    }
  }
}
