{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "disabled": false,
        "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"]
      },
      "jadx-mcp-server": {
        "type": "local",
        "disabled": false,
        "command": ["{env:HOME}/.local/bin/jadx_mcp_server"]
      }
    }
  }
}
